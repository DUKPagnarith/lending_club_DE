{
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus"}],
  "__requires": [{"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"}],
  "title": "Credit Risk — PSI / CSI Monitoring",
  "uid": "credit-risk-psi",
  "tags": ["credit-risk", "monitoring", "psi"],
  "timezone": "browser",
  "refresh": "1h",
  "time": {"from": "now-90d", "to": "now"},
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Score PSI — Credit Score Distribution Stability",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.1},
              {"color": "red", "value": 0.25}
            ]
          },
          "custom": {"lineWidth": 2}
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "credit_risk_psi_value{variable_name=\"credit_score\"}",
          "legendFormat": "Score PSI"
        }
      ],
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      },
      "description": "PSI < 0.10 = STABLE | 0.10-0.25 = MONITOR | > 0.25 = ALERT (model retraining required)"
    },
    {
      "id": 2,
      "title": "PSI by Variable",
      "type": "bargauge",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.1},
              {"color": "red", "value": 0.25}
            ]
          },
          "min": 0, "max": 0.5
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "credit_risk_psi_value",
          "legendFormat": "{{variable_name}}"
        }
      ],
      "options": {"orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3,
      "title": "PSI Alert Status",
      "type": "stat",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.1},
              {"color": "red", "value": 0.25}
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "max(credit_risk_psi_value)",
          "legendFormat": "Max PSI"
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "description": "Current worst-case PSI across all monitored variables"
    },
    {
      "id": 4,
      "title": "Characteristic Stability Index (CSI) Trend",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 18},
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 0.1},
            {"color": "red", "value": 0.25}
          ]},
          "custom": {"lineWidth": 1}
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "credit_risk_csi_value",
          "legendFormat": "{{variable_name}}"
        }
      ],
      "description": "CSI per input feature — flags which variables are drifting"
    }
  ]
}
