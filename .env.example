# ── Copy this file to .env and fill in your values ────────────────────────
# cp .env.example .env

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=credit_risk
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=credit_risk

# ── MinIO (Data Lake) ─────────────────────────────────────────────────────
MINIO_USER=minioadmin
MINIO_PASSWORD=changeme_minio123

# ── Airflow ───────────────────────────────────────────────────────────────
AIRFLOW_FERNET_KEY=          # generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme_airflow

# ── MLflow ────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── FastAPI ───────────────────────────────────────────────────────────────
API_SECRET_KEY=changeme_api_secret

# ── Grafana ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme_grafana

# ── Data paths ────────────────────────────────────────────────────────────
RAW_DATA_FILE=accepted_2007_to_2018Q4.csv
TRAIN_CUTOFF_YEAR=2015
